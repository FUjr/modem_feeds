config main 'main'
	option enabled '0'
	option web_enabled '0'

config sip 'sip'
	option enabled '0'
	option username 'qmodem'
	option interface 'wan'
	option mode 'lan'
	option rtp_start '40000'
	option rtp_end '40031'
	option media_socket_path '/var/run/qmodem_voip/media.sock'
	option engine 'consumer'
	# Outbound mode requires certificate-verified TLS. Keep credentials in UCI
	# with mode 600.
	option outbound_server ''
	option outbound_port '5061'
	option outbound_transport 'tls'
	option outbound_username ''
	option outbound_password ''
	option outbound_realm ''
	option outbound_register_interval '300'
