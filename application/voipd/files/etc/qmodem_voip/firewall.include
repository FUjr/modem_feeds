#!/bin/sh

config=${QMODEM_VOIP_SIP_CONFIG:-/var/run/qmodem_voip/sip.conf}

handles=$(nft -a list chain inet fw4 input 2>/dev/null |
	awk '/comment "?qmodem_voip"?/ { print $NF }')
for handle in $handles; do
	nft delete rule inet fw4 input handle "$handle" || exit 1
done

[ "$(uci -q get qmodem_voip.main.enabled)" = 1 ] || exit 0
[ "$(uci -q get qmodem_voip.sip.enabled)" = 1 ] || exit 0
[ -x /usr/sbin/qmodem_voip_sip_validate ] && /usr/sbin/qmodem_voip_sip_validate >/dev/null 2>&1 || exit 0
[ -r "$config" ] || exit 0

interface=$(uci -q get qmodem_voip.sip.interface)
interface=${interface:-wan}
case $interface in ''|*[!A-Za-z0-9_.:-]*) exit 0 ;; esac
status=$(ubus -t 2 call "network.interface.$interface" status 2>/dev/null) || status=
device=$(printf '%s\n' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)
device=${device:-$interface}
address=$(ip -4 -o addr show dev "$device" scope global 2>/dev/null | awk 'NR == 1 { sub(/\/.*/, "", $4); print $4 }')
[ -n "$address" ] || exit 0

mode=$(uci -q get qmodem_voip.sip.mode)
mode=${mode:-lan}
if [ "$mode" = lan ]; then
	nft add rule inet fw4 input iifname "$device" ip daddr "$address" udp dport 5060 accept comment "qmodem_voip"
	nft add rule inet fw4 input iifname "$device" ip daddr "$address" tcp dport 5060 accept comment "qmodem_voip"
fi
nft add rule inet fw4 input iifname "$device" ip daddr "$address" udp dport 40000-40031 accept comment "qmodem_voip"
