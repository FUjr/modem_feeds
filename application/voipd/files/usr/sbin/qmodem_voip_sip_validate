#!/bin/sh

# Validate the selected SIP topology before procd starts a listener.
set -eu

mode=$(uci -q get qmodem_voip.sip.mode || true)
mode=${mode:-lan}
case "$mode" in
lan)
	engine=$(uci -q get qmodem_voip.sip.engine || true)
	case "${engine:-consumer}" in
	consumer|registrar) exit 0 ;;
	*) echo "unsupported LAN SIP engine: ${engine:-consumer}" >&2; exit 1 ;;
	 esac
	;;
outbound)
	server=$(uci -q get qmodem_voip.sip.outbound_server || true)
	port=$(uci -q get qmodem_voip.sip.outbound_port || true)
	transport=$(uci -q get qmodem_voip.sip.outbound_transport || true)
	username=$(uci -q get qmodem_voip.sip.outbound_username || true)
	password=$(uci -q get qmodem_voip.sip.outbound_password || true)
	realm=$(uci -q get qmodem_voip.sip.outbound_realm || true)
	interval=$(uci -q get qmodem_voip.sip.outbound_register_interval || true)
	case "$server" in
	''|*[!A-Za-z0-9_.:-]*) echo 'invalid outbound_server' >&2; exit 1 ;;
	esac
	case "$transport" in tls) ;; *) echo 'outbound_transport must be tls' >&2; exit 1 ;; esac
	case "$port" in ''|*[!0-9]*) echo 'invalid outbound_port' >&2; exit 1 ;; esac
	[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] || { echo 'invalid outbound_port' >&2; exit 1; }
	[ -n "$username" ] || { echo 'outbound_username is required' >&2; exit 1; }
	[ -n "$password" ] || { echo 'outbound_password is required' >&2; exit 1; }
	case "$username$server$realm$password" in *[!A-Za-z0-9_.:@+%/=-]*) echo 'outbound credentials contain unsafe characters' >&2; exit 1 ;; esac
	case "$interval" in ''|*[!0-9]*) echo 'invalid outbound_register_interval' >&2; exit 1 ;; esac
	[ "$interval" -ge 60 ] 2>/dev/null && [ "$interval" -le 3600 ] || { echo 'invalid outbound_register_interval' >&2; exit 1; }
	exit 0
	;;
*) echo "unsupported SIP mode: $mode" >&2; exit 1 ;;
esac
