#!/bin/sh

set -eu
direction=${1:?direction required}
enabled=$(uci -q get "qmodem_sip.$direction.enabled" || true)
[ "$enabled" = 1 ] || exit 0
interface=$(uci -q get "qmodem_sip.$direction.interface" || true)
case "$interface" in ''|*[!A-Za-z0-9_.:-]*) echo "invalid $direction interface" >&2; exit 1 ;; esac
[ "$(uci -q get "qmodem_sip.$direction.sms_enabled" || true)" != 1 ] ||
	[ -n "$(uci -q get "qmodem_sip.$direction.sms_modem" || true)" ] || exit 1

case "$direction" in
inbound)
	[ "$(uci -q get qmodem_sip.inbound.transport || true)" = udp_tcp ] || exit 1
	port=$(uci -q get qmodem_sip.inbound.listen_port || true)
	[ -n "$(uci -q get qmodem_sip.inbound.username || true)" ] || exit 1
	[ -n "$(uci -q get qmodem_sip.inbound.password || true)" ] || exit 1
	;;
outbound)
	[ "$(uci -q get qmodem_sip.outbound.transport || true)" = tls ] || exit 1
	port=$(uci -q get qmodem_sip.outbound.port || true)
	server=$(uci -q get qmodem_sip.outbound.server || true)
	case "$server" in ''|*[!A-Za-z0-9_.:-]*) exit 1 ;; esac
	[ -n "$(uci -q get qmodem_sip.outbound.username || true)" ] || exit 1
	[ -n "$(uci -q get qmodem_sip.outbound.password || true)" ] || exit 1
	;;
*) exit 2 ;;
esac
case "$port" in ''|*[!0-9]*) exit 1 ;; esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ]
