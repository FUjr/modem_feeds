config sipd 'main'
	option media_socket_path '/var/run/qmodem_voip/media.sock'
	option rtp_start '40000'
	option rtp_end '40031'

config direction 'inbound'
	option enabled '0'
	option interface 'lan'
	option listen_port '5060'
	option transport 'udp_tcp'
	option username 'qmodem'
	option password ''
	option voip_enabled '1'
	option sms_enabled '0'
	option sms_modem ''

config direction 'outbound'
	option enabled '0'
	option interface 'wan'
	option listen_port '5061'
	option server ''
	option port '5061'
	option transport 'tls'
	option username ''
	option password ''
	option realm ''
	option register_interval '300'
	option voip_enabled '1'
	option sms_enabled '0'
	option sms_modem ''
